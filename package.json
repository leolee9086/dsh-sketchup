{
  "name": "@leolee9086/dsh-sketchup",
  "description": "Local DeepSeek Harness integration for SketchUp 2024",
  "version": "0.1.0-alpha.1",
  "keywords": ["dsh-plugin", "deepseek-harness", "sketchup", "cordis", "ruby", "websocket", "cef"],
  "author": "leolee9086",
  "contributors": [
    "Yuxiang Lin and dsh-browser contributors (upstream)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolee9086/dsh-sketchup.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src",
    "ruby",
    "scripts",
    "install.ps1",
    "install.sh",
    "THIRD-PARTY",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.21.0"
  },
  "scripts": {
    "build:cef": "node scripts/build-cef-polyfills.mjs",
    "test": "node scripts/build-cef-polyfills.mjs && vitest run",
    "typecheck": "node scripts/build-cef-polyfills.mjs && tsc -b --pretty false",
    "build": "node scripts/build-cef-polyfills.mjs && tsc -b --pretty false && tsdown"
  },
  "devDependencies": {
    "core-js": "^3.50.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
